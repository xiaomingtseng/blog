<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {% endif %}{{ SITE.title }}</title>
{% if summary %}<meta name="description" content="{{ summary }}">{% else %}<meta name="description" content="{{ SITE.description }}">{% endif %}
<link rel="alternate" type="application/atom+xml" href="/feed.xml">
<link rel="stylesheet" href="/assets/style.css">
{% if math %}<link rel="stylesheet" href="/assets/vendor/katex.min.css">{% endif %}
<script>
  /* 避免深色模式閃爍：在畫面畫出來之前就先套用上次選的主題 */
  (function () {
    var t = localStorage.getItem("deepwater-theme") ||
      (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    document.documentElement.setAttribute("data-theme", t);
  })();
</script>
</head>
<body>
<div class="rh">
  <div class="rh-grid">
    <aside class="rh-side">
      <div>
        <a href="/" class="rh-brand" style="text-decoration:none">{{ SITE.title }}</a>
        <div class="rh-tagline rh-hide-narrow">{{ SITE.description }}</div>
      </div>

      <div class="rh-search" data-search-wrap>
        <span style="color:var(--ink-faint);font-size:12px">⌕</span>
        <input type="text" placeholder="搜尋…" data-search-input aria-label="搜尋筆記">
        <div class="rh-search-results" data-search-results></div>
      </div>

      <nav class="rh-nav">
        <a href="/notes/" {% if page.url == "/notes/" %}class="is-active"{% endif %}>全部</a>
        {% for key, meta in TYPES %}
        <a href="/notes/?type={{ key }}" data-type-nav="{{ key }}">{{ meta.label }}</a>
        {% endfor %}
      </nav>

      <div class="rh-tags rh-hide-narrow">
        <div class="rh-tags-label">常用標籤</div>
        <div class="rh-tag-list">
          {% for tag in collections.allTags | limit(6) %}
          <span style="font:500 11px var(--font-mono);color:var(--accent-ink);background:var(--accent-soft);border-radius:5px;padding:3px 7px">#{{ tag }}</span>
          {% endfor %}
        </div>
      </div>

      <div class="rh-ctrls">
        <button class="btn-chip" data-theme-toggle aria-label="切換深色模式"><span data-theme-glyph>☾</span></button>
        <a class="btn-chip" href="/feed.xml">RSS</a>
        <a class="btn-chip" href="{{ SITE.github }}">GitHub</a>
      </div>
    </aside>

    <main class="rh-main">
      {{ content | safe }}
    </main>
  </div>
</div>

<script src="/assets/theme.js"></script>
<script>window.DEEPWATER_BASE = "{{ '/' | url }}";</script>
<script type="module" src="/assets/search.js"></script>
<script src="/assets/list-filter.js"></script>
<script src="/assets/toc.js"></script>
</body>
</html>
