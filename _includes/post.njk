---
layout: base.njk
---
<div class="post-page">
  <div class="post-topbar">
    <a class="tt" href="/" style="font:500 12.5px var(--font-sans);color:var(--ink-soft)">← {{ SITE.title }}</a>
    <span class="sep">/</span>
    <a class="tt type-link" href="/notes/?type={{ type }}" style="color:var(--c-{{ 'lit' if type == 'literature' else type }})">{{ TYPES[type].label }}</a>
    <div class="post-topbar-ctrls">
      <a class="btn-chip" href="/feed.xml">RSS</a>
      <button class="btn-chip" data-theme-toggle aria-label="切換深色模式"><span data-theme-glyph>☾</span></button>
    </div>
  </div>

  <div class="post-layout">
    <aside class="post-toc">
      <div class="post-toc-label">目錄</div>
      <nav data-toc-nav></nav>
      <div class="post-toc-hint">閱讀進度會即時<br>高亮所在段落</div>
    </aside>

    <article>
      <div class="post-type-label" style="color:var(--c-{{ 'lit' if type == 'literature' else type }})">{{ TYPES[type].label }}</div>
      <h1 class="post-title">{{ title }}</h1>
      <div class="post-meta">
        {{ date | date("yyyy-MM-dd") }}{% if updated %} · 更新於 {{ updated | date("MM-dd") }}{% endif %} · 約 {{ content | readingTime }} 分鐘
      </div>
      <div class="post-tags">
        {% for tag in tags %}<a href="/notes/?tag={{ tag }}">#{{ tag }}</a>{% endfor %}
      </div>
      <div class="post-hr"></div>

      <div class="post-body">
        {{ content | safe }}
      </div>

      {% set prevPost = collections.posts | getPreviousCollectionItem %}
      {% set nextPost = collections.posts | getNextCollectionItem %}
      {% if prevPost or nextPost %}
      <div class="post-pagenav">
        {% if prevPost %}
        <a class="prev" href="{{ prevPost.url }}"><div class="label">← 上一篇</div><div class="title">{{ prevPost.data.title }}</div></a>
        {% else %}<span></span>{% endif %}
        {% if nextPost %}
        <a class="next" href="{{ nextPost.url }}"><div class="label">下一篇 →</div><div class="title">{{ nextPost.data.title }}</div></a>
        {% else %}<span></span>{% endif %}
      </div>
      {% endif %}

      {% set relatedPosts = collections.posts | related(page.url, tags, 2) %}
      {% if relatedPosts.length %}
      <div class="post-related">
        <div class="post-related-label">相關文章</div>
        <div class="post-related-list">
          {% for r in relatedPosts %}
          <a href="{{ r.url }}">
            <span class="post-related-dot" style="background:var(--c-{{ 'lit' if r.data.type == 'literature' else r.data.type }})"></span>
            <span class="post-related-title">{{ r.data.title }}</span>
            <span class="post-related-type">{{ TYPES[r.data.type].label }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </article>
  </div>
</div>
