---
# 這支模板在 build 時輸出 /search-index.json，前端用 Fuse.js 載入做模糊搜尋。
permalink: /search-index.json
eleventyExcludeFromCollections: true
---
[
{%- for p in collections.posts -%}
  {
    "title": {{ p.data.title | dump | safe }},
    "url": {{ p.url | dump | safe }},
    "type": {{ p.data.type | dump | safe }},
    "tags": {{ (p.data.tags or []) | dump | safe }},
    "summary": {{ (p.data.summary or "") | dump | safe }},
    "date": "{{ p.date | date('yyyy-LL-dd') }}"
  }{% if not loop.last %},{% endif %}
{%- endfor -%}
]
